# Copie para ".env" só no seu computador. Na Vercel, estas vão em
# Settings › Environment Variables. Nunca suba o .env para o GitHub.

# Banco Postgres (Neon). Na Vercel, a integração preenche sozinha.
DATABASE_URL=

# Arquivos dos panfletos (Vercel Blob). Na Vercel, preenchido sozinho.
BLOB_READ_WRITE_TOKEN=

# Leitura do panfleto pela IA (console.anthropic.com › API keys).
ANTHROPIC_API_KEY=

# Primeiro usuário da equipe, criado quando não há nenhum: "usuario:sal:hash".
# Gere com: npm run criar-admin
ADMIN_INICIAL=

# WhatsApp Business Cloud API (developers.facebook.com › seu app › WhatsApp).
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# Segredo do app: confere que o aviso veio mesmo da Meta.
WHATSAPP_SEGREDO_APP=
# Frase que você inventa e cola também na Meta, na verificação do webhook.
WHATSAPP_VERIFICACAO=

# Endereço público do site, para os links mandados no WhatsApp.
SITE_URL=https://ofertas-locais.vercel.app
